<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>CombatFlight</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>netcoreapp9.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>11.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="CombatFlight.CombatFlightSong.mp3" />
    <EmbeddedResource Include="CombatFlight.CombatFlightSong.mp3" LogicalName="CombatFlight.CombatFlightSong.mp3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="sts2" />
    <Reference Include="0Harmony" />
    <Reference Include="GodotSharp" />
    <Reference Include="ModConfig" />
  </ItemGroup>
</Project>